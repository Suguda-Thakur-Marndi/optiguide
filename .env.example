# ==========================================
# OptiGuide - Root Environment Configuration Template
# Do NOT place sensitive secrets or passwords in this file.
# Copy this file to .env in backend/ or apps/mobile/ as needed.
# ==========================================

# Backend Configuration
APP_NAME=OptiGuide
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration
# For local SQLite dev: sqlite:///./local_dev.db
# For PostgreSQL dev: postgresql+psycopg://postgres:postgres@localhost:5432/optiguide_dev
DATABASE_URL=sqlite:///./local_dev.db
DB_ECHO=false

# CORS & Security
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8081","http://127.0.0.1:8081"]
LOG_LEVEL=INFO

# Frontend Client Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
