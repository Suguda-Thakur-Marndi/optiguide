# OptiGuide Backend Environment Configuration
APP_NAME=OptiGuide
APP_ENV=development
APP_DEBUG=false
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Local SQLite fallback: sqlite:///./local_dev.db
# PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/optiguide_dev
DATABASE_URL=sqlite:///./local_dev.db
DB_ECHO=false

# Security & JWT Authentication
# IMPORTANT: In production, generate a secure random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=dev-insecure-secret-key-change-in-production-optiguide-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=optiguide-api
JWT_AUDIENCE=optiguide-client
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
REFRESH_TOKEN_GRACE_PERIOD_SECONDS=10

# Rate Limiting & Proxy Configuration
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=5
TRUST_FORWARDED_FOR=false
TRUSTED_PROXIES=["127.0.0.1","::1"]

# CORS & Logging
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://127.0.0.1:8081","http://localhost:19006"]
LOG_LEVEL=INFO
